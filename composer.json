{
    "name": "bartacus/platformsh-bundle",
    "type": "typo3-cms-extension",
    "description": "Support bundle for using Upsun together with TYPO3",
    "keywords": [ "typo3", "symfony", "framework", "integration", "platform.sh", "upsun" ],
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Stefan Herndler"
        },
        {
            "name": "Simon Kendler"
        },
        {
            "name": "pixelart GmbH",
            "homepage": "https://www.pixelart-agency.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2.1",
        "platformsh/config-reader": "^2.4",
        "typo3/cms-core": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "Bartacus\\Bundle\\PlatformshBundle\\": "Classes/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "6.0.x-dev"
        },
        "typo3/cms": {
            "extension-key": "bartacus_platformsh"
        }
    }
}
